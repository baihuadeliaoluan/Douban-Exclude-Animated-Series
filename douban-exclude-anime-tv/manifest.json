{
  "manifest_version": 3,
  "name": "豆瓣排除动画剧集",
  "version": "1.0.0",
  "description": "在豆瓣「看过」页统计排除动画剧集后的电影 / 剧集数量。只读，不改任何标记。",
  "permissions": ["storage"],
  "host_permissions": ["https://movie.douban.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://movie.douban.com/people/*/collect*",
        "https://movie.douban.com/mine*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "豆瓣排除动画剧集",
    "default_popup": "popup.html"
  }
}
